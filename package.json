{
    "name": "playwright-ui-api",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "tests:all": "playwright test",
        "tests:api": "playwright test api/api.spec.ts --project=booker-api",
        "tests:ui-components:chromium": "playwright test ui-components-herokuapp --project=herokuapp-ui-components-chromium",
        "tests:ui-components:firefox": "playwright test ui-components-herokuapp --project=herokuapp-ui-components-firefox",
        "tests:ui-components:safari": "playwright test ui-components-herokuapp --project=herokuapp-ui-components-webkit",
        "tests:e2e:chromium": "playwright test e2e-conduit/e2e.spec.ts --project=conduit-e2e-chromium",
        "tests:e2e:firefox": "playwright test e2e-conduit/e2e.spec.ts --project=conduit-e2e-firefox",
        "tests:e2e:safari": "playwright test e2e-conduit/e2e.spec.ts --project=conduit-e2e-webkit",
        "allure:show": "allure generate ./allure-results -o ./allure-report --clean && allure open ./allure-report",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint:check":  "eslint \"tests/**/*.ts\" \"page-objects/**/*.ts\" \"helpers/**/*.ts\" \"fixtures/**/*.ts\" \"booker-endpoints/**/*.ts\"",
        "lint:fix":  "eslint \"tests/**/*.ts\" \"page-objects/**/*.ts\" \"helpers/**/*.ts\" \"fixtures/**/*.ts\" \"booker-endpoints/**/*.ts\" --fix"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.4.0",
        "@playwright/test": "^1.60.0",
        "@types/node": "^25.9.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "allure-playwright": "^3.9.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.4.1",
        "eslint-plugin-playwright": "^2.10.4",
        "typescript-eslint": "^8.61.0"
    }
}
